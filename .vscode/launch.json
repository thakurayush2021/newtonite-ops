{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Newtonite Ops (http://localhost:5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "5000" }
    },
    {
      "name": "Run with 20,000 demo items (scale test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "5000", "DATABASE": "newtonite-big.db", "SEED_ITEMS": "20000" }
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Standalone job worker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.worker",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
